Notebook[{

Cell[CellGroupData[{
Cell["Four-component BEC: verified linear eigenmodes", "Title",ExpressionUUID->"c124a8ff-0fa9-9a4e-9c22-2916dcf75543"],

Cell["\<\
Mathematica / Wolfram Language. Evaluate this notebook from top to bottom \
(Evaluation > Evaluate Notebook). This self-contained notebook needs no \
accompanying source file.\
\>", "Text",ExpressionUUID->"dd87ce17-0855-664f-90b0-0a273d7b3dbd"],

Cell["\<\
Scope: three leading-order k=1,m=1 density patterns on the unit ball. This \
does not solve or continue the nonlinear stationary PDE. Each component has a \
positive uniform background. The three-lobe full stabilizer has order 12, \
which is not the order-6 diagonal D3 written in the supplied paper.\
\>", "Text",ExpressionUUID->"10ed93ca-97c1-a64b-8943-3e46b041706a"],

Cell["\<\
Defaults: gSelf=1, gCross=2, amplitude=3/20 (15% relative perturbation). Set \
amplitude=4/5 to reproduce the old display contrast, without implying a small \
approximation error. Set exportVideos=True for optional four-second MP4 \
camera rotations, written next to this notebook.\
\>", "Text",ExpressionUUID->"9afcc390-60f6-9a47-8555-258752dcc887"],

Cell["\<\
Verification: exact fixed spaces, residual identities and radial calculations \
were independently checked. Native Mathematica graphics and MP4 export have \
not been executed in the authoring environment.\
\>", "Text",ExpressionUUID->"96e0fc64-24ed-2b4e-890e-196846bedd36"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"ClearAll", "[", "\"\<BECModes`*\>\"", "]"}], ";"}], "\n", 
 RowBox[{
  RowBox[{"Begin", "[", "\"\<BECModes`\>\"", "]"}], ";"}]}], "Input",Expressio\
nUUID->"a93f5951-52f5-3c46-ae9b-8fb3f0d9ab80"],

Cell[CellGroupData[{

Cell["0. Parameters and the first Neumann root", "Section",ExpressionUUID->"d4b6a0a2-42cf-db48-9742-e3a541ee5935"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"require", "[", 
    RowBox[{"ok_", ",", " ", "label_"}], "]"}], " ", ":=", " ", 
   RowBox[{"If", "[", 
    RowBox[{
     RowBox[{"!", " ", 
      RowBox[{"TrueQ", "[", "ok", "]"}]}], ",", " ", 
     RowBox[{
      RowBox[{"Print", "[", 
       RowBox[{"\"\<CHECK FAILED: \>\"", ",", " ", "label"}], "]"}], ";", " ", 
      RowBox[{"Abort", "[", "]"}]}]}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"gSelf", " ", "=", " ", "1"}], ";", " ", 
  RowBox[{"gCross", " ", "=", " ", "2"}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"amplitude", " ", "=", " ", 
    RowBox[{"3", "/", "20"}]}], ";"}], " ", 
  RowBox[{"(*", " ", 
   RowBox[{
    RowBox[{"0.15", ":", " ", 
     RowBox[{"max", " ", "|", 
      RowBox[{"u_j", "-", "c0"}], "|", 
      RowBox[{"/", "c0"}]}]}], ";", " ", 
    RowBox[{
     RowBox[{"4", "/", "5"}], " ", "gives", " ", "a", " ", "large", " ", 
     "illustrative", " ", "contrast"}]}], " ", "*)"}]}], "\n", 
 RowBox[{
  RowBox[{"exportVideos", " ", "=", " ", "True"}], ";"}], "\n", 
 RowBox[{
  RowBox[{"outputDirectory", " ", "=", " ", 
   RowBox[{"Quiet", "[", 
    RowBox[{"Check", "[", 
     RowBox[{
      RowBox[{"NotebookDirectory", "[", "]"}], ",", " ", 
      RowBox[{"Directory", "[", "]"}]}], "]"}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"If", "[", 
   RowBox[{
    RowBox[{"!", " ", 
     RowBox[{"StringQ", "[", "outputDirectory", "]"}]}], ",", " ", 
    RowBox[{"outputDirectory", " ", "=", " ", 
     RowBox[{"Directory", "[", "]"}]}]}], "]"}], ";"}], "\n", 
 RowBox[{
  RowBox[{"require", "[", 
   RowBox[{
    RowBox[{"0", " ", "<", " ", "gSelf", " ", "<", " ", "gCross"}], ",", " ", 
    "\"\<immiscible parameter regime\>\""}], "]"}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"require", "[", 
    RowBox[{
     RowBox[{"0", " ", "<", " ", "amplitude", " ", "<", " ", "1"}], ",", " ", 
     "\"\<positive first-order fields\>\""}], "]"}], ";"}], "\n", "\n", 
  RowBox[{"(*", " ", 
   RowBox[{
    RowBox[{
     RowBox[{
     "s11", " ", "is", " ", "the", " ", "first", " ", "positive", " ", "zero",
       " ", "of", " ", 
      RowBox[{"sJ", "'"}], "_", 
      RowBox[{"{", 
       RowBox[{"3", "/", "2"}], "}"}], 
      RowBox[{"(", "s", ")"}]}], "-", 
     RowBox[{
      RowBox[{"\\", "frac"}], 
      RowBox[{"{", "1", "}"}], 
      RowBox[{"{", "2", "}"}], "J_", 
      RowBox[{"{", 
       RowBox[{"3", "/", "2"}], "}"}], 
      RowBox[{"(", "s", ")"}]}]}], "=", "0"}], " ", "*)"}], "\n", 
  RowBox[{"(*", " ", 
   RowBox[{
    RowBox[{"j_k", 
     RowBox[{"(", "s", ")"}]}], "=", 
    RowBox[{
     RowBox[{"\\", "sqrt"}], 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"\\", "frac"}], 
       RowBox[{"{", 
        RowBox[{"\\", "pi"}], "}"}], 
       RowBox[{"{", 
        RowBox[{"2", "s"}], "}"}]}], "}"}], "J_", 
     RowBox[{"{", 
      RowBox[{"k", "+", 
       RowBox[{
        RowBox[{"\\", "frac"}], 
        RowBox[{"{", "1", "}"}], 
        RowBox[{"{", "2", "}"}]}]}], "}"}], 
     RowBox[{"(", "s", ")"}]}]}], "*)"}], "\[IndentingNewLine]", 
  RowBox[{"(*", 
   RowBox[{" ", 
    RowBox[{
     RowBox[{
     "So", " ", "computation", " ", "of", " ", "s11", " ", "can", " ", "be", 
      " ", "converted", " ", "to", " ", "finding", " ", "zeros", " ", "to"}], 
     " ", "\:ff1a", 
     RowBox[{
      RowBox[{
       RowBox[{"j_", "0", 
        RowBox[{"(", "z", ")"}]}], "-", 
       RowBox[{
        RowBox[{"\\", "frac"}], 
        RowBox[{"{", 
         RowBox[{"2", "j_", "1", 
          RowBox[{"(", "z", ")"}]}], "}"}], 
        RowBox[{"{", "z", "}"}]}]}], "=", "0."}]}], "}"}], 
   "*)"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"s11", " ", "=", " ", 
   RowBox[{"z", " ", "/.", " ", 
    RowBox[{"FindRoot", "[", "\n", "   ", 
     RowBox[{
      RowBox[{
       RowBox[{
        RowBox[{"SphericalBesselJ", "[", 
         RowBox[{"0", ",", " ", "z"}], "]"}], " ", "-", " ", 
        RowBox[{"2", " ", 
         RowBox[{
          RowBox[{"SphericalBesselJ", "[", 
           RowBox[{"1", ",", " ", "z"}], "]"}], "/", "z"}]}]}], " ", "==", 
       " ", "0"}], ",", "\n", "   ", 
      RowBox[{"{", 
       RowBox[{"z", ",", " ", "2"}], "}"}], ",", " ", 
      RowBox[{"WorkingPrecision", " ", "->", " ", "50"}], ",", " ", 
      RowBox[{"AccuracyGoal", " ", "->", " ", "35"}], ",", " ", 
      RowBox[{"PrecisionGoal", " ", "->", " ", "35"}]}], "]"}]}]}], 
  ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"shape", "[", "r_", "]"}], " ", ":=", " ", 
   RowBox[{"SphericalBesselJ", "[", 
    RowBox[{"1", ",", " ", 
     RowBox[{"s11", " ", "r"}]}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"shape1", " ", "=", " ", 
   RowBox[{"shape", "[", "1", "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"mu11", " ", "=", " ", 
   RowBox[{
    RowBox[{"(", 
     RowBox[{"gSelf", " ", "+", " ", 
      RowBox[{"3", " ", "gCross"}]}], ")"}], " ", 
    RowBox[{
     RowBox[{"s11", "^", "2"}], "/", 
     RowBox[{"(", 
      RowBox[{"2", " ", 
       RowBox[{"(", 
        RowBox[{"gCross", " ", "-", " ", "gSelf"}], ")"}]}], ")"}]}]}]}], 
  ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"c11", " ", "=", " ", 
    RowBox[{"Sqrt", "[", 
     RowBox[{"mu11", "/", 
      RowBox[{"(", 
       RowBox[{"gSelf", " ", "+", " ", 
        RowBox[{"3", " ", "gCross"}]}], ")"}]}], "]"}]}], ";"}], "\n", 
  "\[IndentingNewLine]", 
  RowBox[{"(*", " ", 
   RowBox[{"Check", " ", "boundary", " ", "condition"}], 
   "*)"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"radialSlope", " ", "=", " ", 
   RowBox[{"s11", " ", 
    RowBox[{"(", 
     RowBox[{
      RowBox[{"SphericalBesselJ", "[", 
       RowBox[{"0", ",", " ", "s11"}], "]"}], " ", "-", " ", 
      RowBox[{"2", " ", 
       RowBox[{"shape1", "/", "s11"}]}]}], ")"}]}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"require", "[", 
   RowBox[{
    RowBox[{
     RowBox[{"Abs", "[", "radialSlope", "]"}], " ", "<", " ", 
     RowBox[{"10", "^", 
      RowBox[{"-", "25"}]}]}], ",", " ", 
    "\"\<Neumann condition j1'(s11)=0\>\""}], "]"}], ";"}], "\n", 
 RowBox[{
  RowBox[{"Print", "[", 
   RowBox[{"\"\<s11 = \>\"", ",", " ", 
    RowBox[{"N", "[", 
     RowBox[{"s11", ",", " ", "12"}], "]"}], ",", " ", "\"\<; mu11 = \>\"", 
    ",", " ", 
    RowBox[{"N", "[", 
     RowBox[{"mu11", ",", " ", "12"}], "]"}], ",", "\n", "   ", 
    "\"\<; background amplitude c11 = \>\"", ",", " ", 
    RowBox[{"N", "[", 
     RowBox[{"c11", ",", " ", "12"}], "]"}]}], "]"}], ";"}], "\n", 
 RowBox[{
  RowBox[{"Print", "[", 
   RowBox[{
   "\"\<Maximum relative perturbation = \>\"", ",", " ", "amplitude", ",", 
    "\n", "   ", "\"\<. Displayed densities are divided by c11^2.\>\""}], 
   "]"}], ";"}]}], "Input",
 CellChangeTimes->{{4.000886643196594*^9, 4.0008866479543056`*^9}, {

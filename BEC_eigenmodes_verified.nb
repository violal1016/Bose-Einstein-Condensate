             RowBox[{"f", "[", "r", "]"}]}], ")"}], "^", "2"}], " ", 
          RowBox[{
           RowBox[{"(", 
            RowBox[{"1", " ", "-", " ", 
             RowBox[{
              RowBox[{"k", "[", "r", "]"}], "^", "3"}]}], ")"}], "/", 
           "3"}]}]}]}], ";", "\n", "   ", 
       RowBox[{"volume", " ", "=", " ", 
        RowBox[{"2", " ", "Pi", " ", 
         RowBox[{"NIntegrate", "[", 
          RowBox[{
           RowBox[{
            RowBox[{"r", "^", "2"}], " ", 
            RowBox[{"(", 
             RowBox[{"1", " ", "-", " ", 
              RowBox[{"k", "[", "r", "]"}]}], ")"}]}], ",", " ", 
           RowBox[{"{", 
            RowBox[{"r", ",", " ", "rmin", ",", " ", "1"}], "}"}]}], 
          "]"}]}]}], ";", "\n", "   ", 
       RowBox[{"mass", " ", "=", " ", 
        RowBox[{"2", " ", "Pi", " ", 
         RowBox[{"NIntegrate", "[", 
          RowBox[{

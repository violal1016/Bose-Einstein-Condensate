Cell[CellGroupData[{

Cell["4. Optional camera-rotation videos", "Section",ExpressionUUID->"3fdca395-8d87-4f48-822a-1239db146c56"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", " ", 
   RowBox[{
    RowBox[{
     RowBox[{"Set", " ", "exportVideos"}], "=", 
     RowBox[{"True", " ", "above", " ", "to", " ", 
      RowBox[{"enable", ".", " ", "The"}], " ", "camera", " ", "rotates"}]}], 
    ";", " ", 
    RowBox[{
     RowBox[{
      RowBox[{"this", " ", "is", " ", "not", "\n", "   ", "a", " ", "time"}], 
      "-", 
      RowBox[{"dependent", " ", "BEC", " ", 
       RowBox[{"solution", ".", " ", "120"}], " ", 
       RowBox[{"frames", " ", "/", " ", "30"}], " ", "fps"}]}], " ", "=", " ", 
     RowBox[{"4", " ", 
      RowBox[{"seconds", "."}]}]}]}], " ", "*)"}], "\n", 
  RowBox[{"(*", " ", 
   RowBox[{
    RowBox[{
     RowBox[{"Set", " ", "exportVideos"}], "=", 
     RowBox[{"True", " ", "above", " ", "to", " ", 
      RowBox[{"enable", ".", " ", "The"}], " ", "camera", " ", "rotates"}]}], 
    ";", " ", 
    RowBox[{
     RowBox[{
      RowBox[{"this", " ", "is", " ", "not", "\n", "   ", "a", " ", "time"}], 
      "-", 
      RowBox[{"dependent", " ", "BEC", " ", 
       RowBox[{"solution", ".", " ", "120"}], " ", 
       RowBox[{"frames", " ", "/", " ", "30"}], " ", "fps"}]}], " ", "=", " ", 
     RowBox[{"4", " ", 
      RowBox[{"seconds", "."}]}]}]}], " ", "*)"}], "\n", 
  RowBox[{
   RowBox[{
    RowBox[{
     RowBox[{"exportRotation", "[", 
      RowBox[{
      "graphics_", ",", " ", "around_", ",", " ", "start_", ",", " ", 
       "name_"}], "]"}], " ", ":=", " ", 
     RowBox[{"Module", "[", 
      RowBox[{
       RowBox[{"{", "frames", "}"}], ",", "\n", "   ", 
       RowBox[{
        RowBox[{"frames", " ", "=", " ", 
         RowBox[{"Table", "[", 
          RowBox[{
           RowBox[{"Rasterize", "[", 
            RowBox[{
             RowBox[{"Show", "[", 
              RowBox[{"graphics", ",", "\n", "      ", 
               RowBox[{"ViewPoint", " ", "->", " ", 
                RowBox[{
                 RowBox[{"RotationMatrix", "[", 
                  RowBox[{
                   RowBox[{"2", " ", "Pi", " ", 
                    RowBox[{"k", "/", "120"}]}], ",", " ", "around"}], "]"}], 
                 ".", "start"}]}], ",", "\n", "      ", 
               RowBox[{"ViewVertical", " ", "->", " ", "around"}], ",", " ", 
               RowBox[{"ImageSize", " ", "->", " ", "520"}]}], "]"}], ",", 
             " ", "\"\<Image\>\""}], "]"}], ",", " ", 
           RowBox[{"{", 
            RowBox[{"k", ",", " ", "0", ",", " ", "119"}], "}"}]}], "]"}]}], 
        ";", "\n", "   ", 
        RowBox[{"Export", "[", 
         RowBox[{
          RowBox[{"FileNameJoin", "[", 
           RowBox[{"{", 
            RowBox[{"outputDirectory", ",", " ", "name"}], "}"}], "]"}], ",", 
          " ", "frames", ",", "\n", "      ", 
          RowBox[{"FrameRate", " ", "->", " ", "30"}], ",", " ", 
          RowBox[{"VideoEncoding", " ", "->", " ", "\"\<H264\>\""}]}], 
         "]"}]}]}], "]"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"If", "[", 
     RowBox[{
      RowBox[{"TrueQ", "[", "exportVideos", "]"}], ",", "\n", "   ", 
      RowBox[{
       RowBox[{"Print", "[", 
        RowBox[{"exportRotation", "[", 
         RowBox[{"tetraPlot", ",", " ", 
          RowBox[{"{", 
           RowBox[{"0", ",", " ", "0", ",", " ", "1"}], "}"}], ",", " ", 
          RowBox[{"{", 
           RowBox[{"2.2", ",", " ", 
            RowBox[{"-", "2.6"}], ",", " ", "1.5"}], "}"}], ",", " ", 
          "\"\<tetrahedral_linear_mode.mp4\>\""}], "]"}], "]"}], ";", "\n", 
       "   ", 
       RowBox[{"Print", "[", 
        RowBox[{"exportRotation", "[", 
         RowBox[{"d3hPlot", ",", " ", 
          RowBox[{"N", "[", 
           RowBox[{"Normalize", "[", 
            RowBox[{"{", 
             RowBox[{"1", ",", 
              RowBox[{"-", "1"}], ",", 
              RowBox[{"-", "1"}]}], "}"}], "]"}], "]"}], ",", " ", 
          RowBox[{"3.3", " ", 
           RowBox[{"Normalize", "[", 
            RowBox[{"{", 
             RowBox[{"1", ",", " ", 
              RowBox[{"-", "2"}], ",", " ", "2"}], "}"}], "]"}]}], ",", " ", 
          "\"\<D3h_linear_mode.mp4\>\""}], "]"}], "]"}]}]}], "]"}], 
    ";"}]}]}]], "Input",

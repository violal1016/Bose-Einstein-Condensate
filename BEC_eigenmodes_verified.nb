                  RowBox[{"f", "[", "r", "]"}]}], ")"}], "^", "2"}]}]}], 
             ")"}]}], ",", " ", 
           RowBox[{"{", 
            RowBox[{"r", ",", " ", "0", ",", " ", "1"}], "}"}]}], "]"}]}]}], 

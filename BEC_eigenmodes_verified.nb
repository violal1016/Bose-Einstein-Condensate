           "\[IndentingNewLine]", 
           RowBox[{"If", "[", 
            RowBox[{
             RowBox[{
              RowBox[{
               RowBox[{"RandomReal", "[", "]"}], " ", "rhoMax"}], "<=", 
              "rho"}], ",", 
             RowBox[{
              RowBox[{"Sow", "[", "x", "]"}], ";", "\[IndentingNewLine]", 
              RowBox[{"count", "++"}], ";"}]}], "]"}], ";"}]}], "]"}], "]"}], 

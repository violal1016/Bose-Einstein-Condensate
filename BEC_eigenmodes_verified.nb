Cell["1. Exact representation and fixed-point calculations", "Section",ExpressionUUID->"4d210d05-cb3a-bf44-b817-ef0d1dca1abd"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"id4", "=", 
   RowBox[{"Range", "[", "4", "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"eye3", "=", 
   RowBox[{"IdentityMatrix", "[", "3", "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"require", "[", 
     RowBox[{"ok_", ",", "label_"}], "]"}], ":=", 
    RowBox[{"If", "[", 
     RowBox[{
      RowBox[{"!", 
       RowBox[{"TrueQ", "[", "ok", "]"}]}], ",", 
      RowBox[{
       RowBox[{"Print", "[", 
        RowBox[{"\"\<CHECK FAILED: \>\"", ",", "label"}], "]"}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"Abort", "[", "]"}]}]}], "]"}]}], ";"}], "\[IndentingNewLine]",
   "\[IndentingNewLine]", 
  RowBox[{"(*", 
   RowBox[{
    RowBox[{
     RowBox[{
     "Action", " ", "on", " ", "the", " ", "4", " ", "x", " ", "3", " ", 
      "coefficient", " ", 
      RowBox[{"matrix", ":", 
       RowBox[{"spatial", " ", "inverse"}]}]}], "=", 
     RowBox[{"Transpose", "[", "g", "]"}]}], ";", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"component", " ", "inverse"}], "=", 
     RowBox[{
      RowBox[{"Ordering", "[", "perm", "]"}], "."}]}]}], "*)"}]}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"act", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"g_", ",", "perm_"}], "}"}], ",", "a_"}], "]"}], ":=", 
    RowBox[{
     RowBox[{"(", 
      RowBox[{"a", ".", 
       RowBox[{"Transpose", "[", "g", "]"}]}], ")"}], "[", 
     RowBox[{"[", 
      RowBox[{"Ordering", "[", "perm", "]"}], "]"}], "]"}]}], ";"}], 
  "\[IndentingNewLine]", 
  RowBox[{"(*", 
   RowBox[{"Basis", " ", "of", " ", "V1", " ", "tensor", " ", 
    RowBox[{"W4", ":", 
     RowBox[{
     "each", " ", "coefficient", " ", "column", " ", "has", " ", "sum", " ", 
      RowBox[{"zero", "."}]}]}]}], "*)"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"cvecs", "=", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"1", ",", 
       RowBox[{"-", "1"}], ",", "0", ",", "0"}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"0", ",", "1", ",", 
       RowBox[{"-", "1"}], ",", "0"}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"0", ",", "0", ",", "1", ",", 
       RowBox[{"-", "1"}]}], "}"}]}], "}"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"basis", "=", 
   RowBox[{"Flatten", "[", 
    RowBox[{
     RowBox[{"Table", "[", 
      RowBox[{
       RowBox[{"Outer", "[", 
        RowBox[{"Times", ",", 
         RowBox[{"cvecs", "[", 
          RowBox[{"[", "i", "]"}], "]"}], ",", 
         RowBox[{"UnitVector", "[", 
          RowBox[{"3", ",", "j"}], "]"}]}], "]"}], ",", 
       RowBox[{"{", 
        RowBox[{"i", ",", "3"}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{"j", ",", "3"}], "}"}]}], "]"}], ",", "1"}], "]"}]}], 
  ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"constraint", "[", "h_", "]"}], ":=", 
   RowBox[{"Transpose", "[", 
    RowBox[{
     RowBox[{"(", 
      RowBox[{
       RowBox[{"Flatten", "[", 
        RowBox[{
         RowBox[{"act", "[", 
          RowBox[{"h", ",", "#"}], "]"}], "-", "#"}], "]"}], "&"}], ")"}], "/@",
      "basis"}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"fromCoefficients", "[", "v_", "]"}], ":=", 
   RowBox[{"Total", "[", 
    RowBox[{"MapThread", "[", 
     RowBox[{"Times", ",", 
      RowBox[{"{", 
       RowBox[{"v", ",", "basis"}], "}"}]}], "]"}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"fixedMatrices", "[", "generators_", "]"}], ":=", 
   RowBox[{"fromCoefficients", "/@", 
    RowBox[{"NullSpace", "[", 
     RowBox[{"Join", "@@", 
      RowBox[{"(", 
       RowBox[{"constraint", "/@", "generators"}], ")"}]}], "]"}]}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"zeroMatrixQ", "[", "m_", "]"}], ":=", 
    RowBox[{"And", "@@", 
     RowBox[{"(", 
      RowBox[{
       RowBox[{
        RowBox[{"TrueQ", "[", 
         RowBox[{"#", "==", "0"}], "]"}], "&"}], "/@", 
       RowBox[{"Flatten", "[", "m", "]"}]}], ")"}]}]}], ";"}], 
  "\[IndentingNewLine]", "\[IndentingNewLine]", 
  RowBox[{"(*", 
   RowBox[{"Component", " ", "permutations"}], "*)"}]}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"p12", "=", 
    RowBox[{"{", 
     RowBox[{"2", ",", "1", ",", "3", ",", "4"}], "}"}]}], ";"}], "   ", 
  RowBox[{"(*", 
   RowBox[{"(", "12", ")"}], "*)"}]}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"p123", "=", 
    RowBox[{"{", 
     RowBox[{"2", ",", "3", ",", "1", ",", "4"}], "}"}]}], ";"}], "  ", 
  RowBox[{"(*", 
   RowBox[{"(", "123", ")"}], "*)"}]}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"p4", "=", 
    RowBox[{"{", 
     RowBox[{"2", ",", "3", ",", "4", ",", "1"}], "}"}]}], ";"}], "    ", 
  RowBox[{"(*", 
   RowBox[{"(", "1234", ")"}], "*)"}], "\[IndentingNewLine]", "\n", 
  RowBox[{"(*", " ", 
   RowBox[{"===", 
    RowBox[{"==", 
     RowBox[{"1.", " ", 
      RowBox[{"S4", "^", 
       RowBox[{"-", "x_"}]}], 
      RowBox[{"{", "S4", "}"}], " ", "S4"}]}], "===", "=="}], "*)"}], 
  "\[IndentingNewLine]", 
  RowBox[{"(*", 
   RowBox[{
    RowBox[{
    "Spatial", " ", "matrices", " ", "from", " ", "the", " ", "tetrahedral", 
     " ", "hand", " ", 
     RowBox[{"calculation", ".", "These"}], " ", "are", " ", "the", " ", 
     "matrices", " ", "themselves"}], ",", 
    RowBox[{"not", " ", "their", " ", 
     RowBox[{"inverses", "."}]}]}], "*)"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"gTet12", "=", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"0", ",", "0", ",", 
       RowBox[{"-", "1"}]}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"0", ",", "1", ",", "0"}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"-", "1"}], ",", "0", ",", "0"}], "}"}]}], "}"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"gTet4", "=", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"0", ",", "1", ",", "0"}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"-", "1"}], ",", "0", ",", "0"}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"0", ",", "0", ",", 
       RowBox[{"-", "1"}]}], "}"}]}], "}"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"tetraGenerators", "=", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"gTet12", ",", "p12"}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"gTet4", ",", "p4"}], "}"}]}], "}"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"fixTet", "=", 
   RowBox[{"fixedMatrices", "[", "tetraGenerators", "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"require", "[", 
   RowBox[{
    RowBox[{
     RowBox[{"Length", "[", "fixTet", "]"}], "==", "1"}], ",", 
    "\"\<fixed space is one-dimensional\>\""}], "]"}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"aTet", "=", 
    RowBox[{"First", "[", "fixTet", "]"}]}], ";"}], "\[IndentingNewLine]", 
  "\n", "\[IndentingNewLine]", 
  RowBox[{"(*", " ", 
